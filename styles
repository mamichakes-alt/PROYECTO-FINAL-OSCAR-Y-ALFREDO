h1 {
    color: rgb(1, 1, 19);
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background-color: rgb(155, 227, 255);
    margin: 0;
    line-height: 1.6;
}

/* Encabezado */
header {
    background-color: rgba(250, 2, 2, 0.815);
    color: beige;
    text-align: center;
    padding: 20px;
}

/* Menú */
nav {
    background-color: #34495e;
    text-align: center;
    padding: 12px;
}

/* Enlaces del menú */
nav a {
    color: white;
    text-decoration: none;
    margin: 0 15px;
    font-weight: bold;
    transition: color 0.3s;
}

/* Efecto al pasar el mouse */
nav a:hover {
    color: #000000;
}

/* Secciones */
section {
    background-color: rgb(255, 229, 190);
    margin: 20px auto;
    padding: 20px;
    width: 80%;
    border: 1px solid black;
    border-radius: 10px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
}

/* Imágenes */
img {
    border-radius: 10px;
    margin-top: 20px;
    max-width: 100%;
    height: auto;
}

/* Pie de página */
footer {
    background-color: rgb(22, 22, 22);
    color: rgb(255, 255, 255);
    text-align: center;
    padding: 10px;
    margin-top: 20px;
}

/* Botones */
button {
    padding: 10px 20px;
    font-size: 16px;
    background-color: rgb(22, 1, 1);
    color: rgb(247, 247, 250);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: transform 0.15s, background-color 0.35s;
}

/* Efecto al presionar */
button:active {
    transform: scale(0.95);
    background-color: rgb(252, 252, 253);
    color: black;
}

/* Mensajes ocultos */
#mensaje,
#mensaje2 {
    display: none;
    opacity: 0;
    transform: translateX(-10px);
    transition: all 0.5s ease;
    font-weight: bold;
    color: rgb(0, 0, 0);
    margin-top: 10px;
}

/* Modo oscuro */
.dark-mode {
    background-color: #1e1e1e;
    color: white;
}

.dark-mode section {
    background-color: #2c2c2c;
    color: white;
}

.dark-mode nav {
    background-color: #111;
}

.dark-mode footer {
    background-color: black;
}